# App
# Public base URL of this site. Used to build the /auth/confirm redirect for
# password-reset emails. Dev: http://localhost:3000 — no trailing slash.
NEXT_PUBLIC_SITE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (transactional email)
RESEND_API_KEY=
# From-address for outbound mail. Dev: onboarding@resend.dev (no DNS, delivers
# only to the Resend account owner's verified address). Flips to the verified
# subdomain (e.g. admissions@mail.modern.edu.np) at go-live. Never hardcode.
RESEND_FROM=

# Office / admissions notifications
OFFICE_NOTIFICATION_EMAIL=
